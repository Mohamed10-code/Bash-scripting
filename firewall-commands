🔥 firewalld / firewall-cmd Cheatsheet

🟢 Service Management

sudo systemctl start firewalld      # Start firewall
sudo systemctl stop firewalld       # Stop firewall
sudo systemctl restart firewalld    # Restart firewall
sudo systemctl enable firewalld     # Enable at boot
sudo systemctl disable firewalld    # Disable at boot
sudo systemctl status firewalld     # Check status

📊 Basic firewall-cmd Info

firewall-cmd --list-ports
firewall-cmd --list-services
firewall-cmd --list-all

firewall-cmd --state                # Check if running
firewall-cmd --get-default-zone    # Show default zone
firewall-cmd --get-active-zones    # Show active zones
firewall-cmd --list-all            # Show all rules (current zone)

firewall-cmd --get-zones
firewall-cmd --get-active-zones

firewall-cmd --set-default-zone=public

firewall-cmd --add-port=80/tcp
firewall-cmd --add-port=443/tcp

#permanent -add 
firewall-cmd --permanent --add-port=80/tcp
firewall-cmd --permanent --add-port=443/tcp
firewall-cmd --reload

#remove ports 
firewall-cmd --remove-port=80/tcp
firewall-cmd --permanent --remove-port=80/tcp
firewall-cmd --reload

firewall-cmd --add-service=http
firewall-cmd --add-service=https
firewall-cmd --add-service=ssh

🚫 Remove Services

firewall-cmd --remove-service=http
firewall-cmd --permanent --remove-service=http
firewall-cmd --reload

# allow specific IP 
firewall-cmd --add-source=192.168.1.10
firewall-cmd --permanent --add-source=192.168.1.10

🔐 Rich Rules (Advanced)


firewall-cmd --add-rich-rule='rule family="ipv4" source address="192.168.1.10" accept'

#Block IP 

firewall-cmd --add-rich-rule='rule family="ipv4" source address="192.168.1.10" drop'


